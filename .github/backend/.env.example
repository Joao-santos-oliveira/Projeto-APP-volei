# Copie este arquivo para .env (uso local) ou configure estas variáveis
# diretamente no painel do Render (Environment > Environment Variables).

# Connection string do Postgres (Neon, Supabase, Render Postgres, etc.)
DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco

# Segredo usado para assinar os tokens JWT — use um valor longo e aleatório
JWT_SECRET=troque_por_um_valor_aleatorio_bem_grande

PORT=3001
